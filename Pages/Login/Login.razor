@page "/"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<div class="login-wrapper">
    <div class="login-container">
        <!-- Visual Section (Track + Car Overlay) -->
        <div class="visual-section">
            <div class="ambient-glow"></div>
            <img src="images/TRACK_PATH.png" class="bg-track" alt="Racetrack Background" />
            <img src="images/CAR_PATH.png" class="hero-car" alt="Sports Car" />
        </div>

        <!-- Glassmorphism Form Card -->
        <div class="form-card">
            <div class="brand-badge">APEX RACING</div>
            <h1 class="form-title">LOGIN</h1>
            
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                
                <div class="input-group">
                    <InputText @bind-Value="loginModel.Username" id="username" class="custom-input" placeholder=" " />
                    <label for="username">Username</label>
                    <span class="input-focus-border"></span>
                </div>

                <div class="input-group">
                    <InputText @bind-Value="loginModel.Password" id="password" type="password" class="custom-input" placeholder=" " />
                    <label for="password">Password</label>
                    <span class="input-focus-border"></span>
                </div>

                <button type="submit" class="btn-login">
                    <span>START ENGINE</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </EditForm>

            <div class="form-footer">
                <NavLink href="register" class="register-link">Don't have an account? <span>Register</span></NavLink>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();

    private void HandleLogin()
    {
        Navigation.NavigateTo("/home");
    }

    public class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}